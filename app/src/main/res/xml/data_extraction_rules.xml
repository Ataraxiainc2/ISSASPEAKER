<?xml version="1.0" encoding="utf-8"?>
<!--
    Secrets never leave the phone through backup or device transfer (catalog F017).
    Excluded: the database (conversation history and cached data), the encrypted preferences and the
    secrets/ folder that hold wrapped AI keys. Their Keystore keys cannot leave the device anyway, so a
    restored copy would be unreadable; excluding them keeps even the ciphertext at home.
    Cloud backup is off altogether (allowBackup="false" in the manifest); these rules matter for device-to-device
    transfer, which Android 12+ performs even then.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="secure_prefs.xml" />
        <exclude domain="file" path="secrets/" />
        <exclude domain="file" path="cast_audio/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="secure_prefs.xml" />
        <exclude domain="file" path="secrets/" />
        <exclude domain="file" path="cast_audio/" />
    </device-transfer>
</data-extraction-rules>
