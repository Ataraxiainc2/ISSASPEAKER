    <string name="about_what_title">O que é</string>
    <string name="about_what_body">O ISSASPEAKER une seu alto-falante Google Home, sua conta Google, sua música e modelos de IA que funcionam com suas próprias chaves, para que serviços que nunca conversam entre si compartilhem uma mesma rotina.</string>
    <string name="about_privacy_title">Seus dados</string>
    <string name="about_privacy_body">O ISSASPEAKER não tem servidor. Suas chaves, tokens e histórico ficam neste celular, criptografados, e ficam fora dos backups. Cada permissão é pedida só quando o recurso que precisa dela é usado pela primeira vez.</string>
    <string name="about_status_title">Status</string>
    <string name="about_status_body">Em desenvolvimento inicial.</string>
    <string name="about_languages_title">Idiomas</string>
    <string name="about_languages_body">Inglês, espanhol (América Latina) e português (Brasil). Mude em Configurações.</string>
    <string name="about_source_title">Código aberto</string>
    <string name="about_source_body">Todo o código é público, sob a licença MIT.</string>
    <string name="about_source_link">Ver o código no GitHub</string>
