    <string name="about_languages_title">Languages</string>
    <string name="about_languages_body">English, Spanish (Latin America) and Portuguese (Brazil). Change it in Settings.</string>
    <string name="about_source_title">Open source</string>
    <string name="about_source_body">All the code is public, under the MIT license.</string>
