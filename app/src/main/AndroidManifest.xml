<?xml version="1.0" encoding="utf-8"?>
<!--
    M0 asks for no permissions at all: not even INTERNET. Google Fonts arrive through the Play Services
    font provider, which downloads on its own. Each permission is added with the feature that needs it.

    allowBackup="false": nothing goes to cloud backup (CodeQL java/android/backup-enabled). The language lives
    in the system's per-app locale setting, which Android keeps on its own. data_extraction_rules.xml still
    governs device-to-device transfer, which Android 12+ allows regardless of allowBackup.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.IssaSpeaker">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
