<?xml version="1.0" encoding="utf-8"?>
<!--
    Permissions are added only with the feature that needs them:
    - INTERNET: the Google profile photo (Sign in with Google), the AI provider registry (models.dev) and the AI
      providers the owner adds. Google Fonts arrive through the Play Services font provider, which downloads on
      its own.
    - ACCESS_LOCAL_NETWORK: finding and talking to the Google Home speaker on the home Wi-Fi (Android 17 local
      network protection). Asked at run time, only on phones that have it, when the owner opens the speaker screen.
    Merged from libraries (documented in docs/security/THREAT-MODEL.md):
    - ACCESS_NETWORK_STATE, FOREGROUND_SERVICE and DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION: Google Cast SDK.
    - USE_BIOMETRIC, USE_FINGERPRINT: androidx.biometric, brought by Block Store (AI key vault).

    allowBackup="false": nothing goes to cloud backup (CodeQL java/android/backup-enabled). The language lives
    in the system's per-app locale setting, which Android keeps on its own. data_extraction_rules.xml still
    governs device-to-device transfer, which Android 12+ allows regardless of allowBackup.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />

    <!-- To open the Google Home app from the speaker screen when a speaker still has to be set up. -->
    <queries>
        <package android:name="com.google.android.apps.chromecast.app" />
    </queries>

    <application
        android:name=".IssaSpeakerApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.IssaSpeaker">
        <meta-data
            android:name="com.google.android.gms.cast.framework.OPTIONS_PROVIDER_CLASS_NAME"
            android:value="com.issasoda.issaspeaker.speaker.CastOptionsProvider" />

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
